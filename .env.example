# 本地验收使用独立启动的Java招聘服务，不修改官网联系我们。
NEXT_PUBLIC_RECRUITMENT_API_ORIGIN=http://127.0.0.1:8081
# 动作迁移对比视频与封面 OSS 域名（留空则默认使用阿里云 OSS 桶域名）。
NEXT_PUBLIC_TRANSFER_MEDIA_ORIGIN=https://xianova-web.oss-cn-shenzhen.aliyuncs.com

# 可选：子路径预览构建；正常官网留空。与 Next basePath、开场和公共资源一致。
NEXT_PUBLIC_BASE_PATH=
# 仅独立 Node 容器构建设为 1，Vercel 与本地开发留空。
XIANOVA_STANDALONE=

# 微信公众号新闻同步，仅在服务端配置。
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_APP_SECRET=
